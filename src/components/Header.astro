---
const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
];

// Treat /projects/some-project as part of the Projects section.
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header container">
  <a class="wordmark" href="/" aria-label="Home">
    Nicolas<span class="wordmark-period">.</span>
  </a>

  <div class="header-end">
    <nav aria-label="Main navigation">
      {links.map(({ href, label }) => (
        <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
          {label}
        </a>
      ))}
    </nav>

    <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
      <!-- Sun, shown in dark mode -->
      <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
      <!-- Moon, shown in light mode -->
      <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />
      </svg>
    </button>
  </div>
</header>

<style>
  .site-header {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .wordmark {
    color: var(--color-text);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: var(--space-3);
  }

  nav a {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-accent);
  }

  nav a[aria-current='page'] {
    color: var(--color-text);
  }

  .header-end {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .theme-toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Show the icon for the theme you would switch to. The effective theme
     is the data-theme attribute when set, otherwise the system setting. */
  .icon-sun {
    display: none;
  }

  :global([data-theme='dark']) .icon-sun {
    display: block;
  }

  :global([data-theme='dark']) .icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .icon-moon {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .site-header {
      min-height: 68px;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');

  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.dataset.theme ??
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const nextTheme = current === 'dark' ? 'light' : 'dark';

    root.dataset.theme = nextTheme;
    try {
      localStorage.setItem('theme', nextTheme);
    } catch {}
  });
</script>
