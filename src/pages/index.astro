---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="site-shell">
    <header class="site-header container">
      <a class="wordmark" href="/" aria-label="Home">
        Nicolas<span class="wordmark-period">.</span>
      </a>

      <nav aria-label="Main navigation">
        <a href="/projects">Projects</a>
        <a href="/about">About</a>
      </nav>
    </header>

    <main class="container">
      <section class="intro">
        <p class="eyebrow">Computer Engineering · Montréal</p>

        <h1>Nicolas<span class="wordmark-period">.</span></h1>

        <div class="intro-copy">
          <p>
            I'm a computer engineering master's student with a background
            in mechanical engineering.
          </p>
          <p>
            My work spans robotics, embedded systems, and research, with
            a particular interest in bringing hardware and software
            together into working systems.
          </p>
          <p>
            I'm currently researching collaborative localization and
            state estimation at Polytechnique Montréal.
          </p>
        </div>

        <a class="text-link" href="/projects">
          Explore projects <span aria-hidden="true">↗</span>
        </a>
      </section>
    </main>

    <footer class="site-footer container">
      <span>Engineering portfolio</span>
      <span>© {new Date().getFullYear()} Nicolas</span>
    </footer>
  </div>
</Layout>

<style>
  .site-shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .site-header {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .wordmark {
    color: var(--color-text);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .wordmark-period {
    color: var(--color-accent);
  }

  nav {
    display: flex;
    gap: var(--space-3);
  }

  nav a {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  nav a:hover,
  .text-link:hover {
    color: var(--color-accent);
  }

  .intro {
    max-width: 760px;
    padding-top: clamp(6rem, 18vh, 11rem);
    padding-bottom: clamp(6rem, 18vh, 11rem);
  }

  .intro .eyebrow {
    margin-bottom: var(--space-3);
  }

  h1 {
    margin-bottom: var(--space-4);
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.075em;
    line-height: 1;
  }

  .intro-copy {
    max-width: 590px;
    margin-bottom: var(--space-4);
  }

  .intro-copy p {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  @media (max-width: 640px) {
    .site-header {
      min-height: 68px;
    }

    .intro {
      padding-top: 6rem;
      padding-bottom: 6rem;
    }

    .intro-copy p {
      font-size: var(--text-base);
    }

    .site-footer {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>