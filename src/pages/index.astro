---
import Layout from '../layouts/Layout.astro';
import { SHOW_FULL_SITE } from '../site.config';

// Projects-only mode: send visitors straight to the project list.
if (!SHOW_FULL_SITE) return Astro.redirect('/projects', 301);
---

<Layout>
  <main class="container">
    <section class="intro">
      <p class="eyebrow">Computer Engineering · Montréal</p>

      <h1>Nicolas<span class="wordmark-period">.</span></h1>

      <div class="intro-copy">
        <p>
          I'm a computer engineering master's student with a background
          in mechanical engineering.
        </p>
        <p>
          My work spans robotics, embedded systems, and research, with
          a particular interest in bringing hardware and software
          together into working systems.
        </p>
        <p>
          I'm currently researching collaborative localization and
          state estimation at Polytechnique Montréal.
        </p>
      </div>

      <a class="text-link" href="/projects">
        Explore projects <span aria-hidden="true">↗</span>
      </a>
    </section>
  </main>
</Layout>

<style>
  .intro {
    max-width: 760px;
    padding-top: clamp(6rem, 18vh, 11rem);
    padding-bottom: clamp(6rem, 18vh, 11rem);
  }

  .intro .eyebrow {
    margin-bottom: var(--space-3);
  }

  h1 {
    margin-bottom: var(--space-4);
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.075em;
    line-height: 1;
  }

  .intro-copy {
    max-width: 590px;
    margin-bottom: var(--space-4);
  }

  .intro-copy p {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .text-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 700px) {
    .intro {
      padding-top: 6rem;
      padding-bottom: 6rem;
    }

    .intro-copy p {
      font-size: var(--text-base);
    }
  }
</style>
