---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects
    .filter((project) => import.meta.env.DEV || !project.data.draft)
    .map((project) => ({
      params: { slug: project.id },
      props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={`${project.data.title} | Nicolas`}>
  <main class="project-page">
    <a class="back-link" href="/projects">← All projects</a>

    <header class="project-header">
      <p class="project-category">{project.data.category}</p>
      <h1>{project.data.title}</h1>
      <p class="project-description">{project.data.description}</p>

      <ul class="project-tags" aria-label="Technologies and topics">
        {project.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>

    {project.data.cover && (
      <img
        class="project-cover"
        src={project.data.cover}
        alt={`Cover image for ${project.data.title}`}
      />
    )}

    <article class="project-content">
      <Content />
    </article>

    <footer class="project-footer">
      <a class="back-link" href="/projects">← Back to all projects</a>
    </footer>
  </main>
</Layout>

<style>
  .project-page {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-5) var(--space-4);
  }

  .back-link {
    display: inline-block;
    color: var(--color-muted, #777);
    text-decoration: none;
    margin-bottom: var(--space-5);
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .project-header {
    max-width: var(--reading-width);
    margin-bottom: var(--space-5);
  }

  .project-category {
    margin-bottom: var(--space-2);
    color: var(--color-accent);
    font-size: 0.9rem;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-3);
  }

  .project-description {
    font-size: 1.2rem;
    line-height: 1.7;
    margin-bottom: var(--space-3);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
  }

  .project-tags li {
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 0.4rem 0.65rem;
    font-size: 0.85rem;
  }

  .project-cover {
    display: block;
    width: 100%;
    max-height: 600px;
    object-fit: cover;
    margin-bottom: var(--space-5);
  }

  .project-content {
    max-width: var(--reading-width);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .project-content :global(h2) {
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    font-size: 1.8rem;
    line-height: 1.3;
  }

  .project-content :global(h3) {
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
    font-size: 1.3rem;
  }

  .project-content :global(p),
  .project-content :global(ul),
  .project-content :global(ol) {
    margin-bottom: var(--space-3);
  }

  .project-content :global(img) {
    max-width: 100%;
    height: auto;
  }

  .project-content :global(pre) {
    overflow-x: auto;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .project-footer {
    margin-top: var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 700px) {
    .project-page {
      padding: var(--space-4) var(--space-3);
    }
  }
</style>
