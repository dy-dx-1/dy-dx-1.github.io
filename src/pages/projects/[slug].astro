---
import Layout from '../../layouts/Layout.astro';
import { render } from 'astro:content';
import { getPublishedProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={project.data.title} description={project.data.description}>
  <main class="project-page">
    <a class="back-link" href="/projects">← All projects</a>

    <header class="project-header">
      <p class="project-category">{project.data.category}</p>
      <h1>{project.data.title}</h1>
      <p class="project-description">{project.data.description}</p>

      <ul class="tag-list" aria-label="Technologies and topics">
        {project.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>

    {project.data.gallery.length > 0 ? (
      <section class="project-gallery" aria-label="Project images">
        <button
          class="gallery-arrow gallery-prev"
          type="button"
          aria-label="Previous image"
        >
          &#8592;
        </button>

        <div class="gallery-track">
          {project.data.gallery.map((image, index) => (
            <div class="gallery-slide">
              <img
                src={image}
                alt={`${project.data.title} image ${index + 1}`}
                loading="lazy"
              />
            </div>
          ))}
        </div>

        <button
          class="gallery-arrow gallery-next"
          type="button"
          aria-label="Next image"
        >
          &#8594;
        </button>
      </section>
    ) : project.data.cover ? (
      <img
        class="project-cover"
        src={project.data.cover}
        alt={`Cover image for ${project.data.title}`}
      />
    ) : null}

    <article class="project-content">
      <Content />
    </article>

    <footer class="project-footer">
      <a class="back-link" href="/projects">← Back to all projects</a>
    </footer>
  </main>
</Layout>

<style>
  .project-page {
    width: 100%;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-5) var(--space-4);
  }

  .back-link {
    display: inline-block;
    margin-bottom: var(--space-5);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .project-header {
    max-width: var(--reading-width);
    margin: 0 auto var(--space-5);
  }

  .project-header .project-category {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
  }

  h1 {
    margin-bottom: var(--space-3);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .project-description {
    margin-bottom: var(--space-3);
    font-size: 1.2rem;
    line-height: 1.7;
  }

  .project-cover {
    display: block;
    width: 100%;
    max-height: 560px;
    object-fit: cover;
    object-position: center;
    border-radius: 4px;
    margin-bottom: var(--space-6);
  }

  /* Gallery */
  .project-gallery {
    position: relative;
    width: 100%;
    margin: 0 auto var(--space-6);
  }

  .gallery-track {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;

    /* Allow the first and last slides to be centered */
    padding-inline: 12%;
    scroll-padding-inline: 12%;
  }

  .gallery-track::-webkit-scrollbar {
    display: none;
  }

  .gallery-slide {
    flex: 0 0 76%;
    min-width: 0;
    height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    scroll-snap-align: center;
  }

  .gallery-slide img {
    display: block;
    max-height: 100%;
    width: auto;
    object-fit: contain;
    border-radius: 6px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.14);
  }

  .gallery-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 42px;
    height: 42px;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-background);
    color: var(--color-text);
    cursor: pointer;
    font-size: 1.25rem;
  }

  .gallery-prev {
    left: 0.75rem;
  }

  .gallery-next {
    right: 0.75rem;
  }

  .gallery-arrow:hover {
    border-color: var(--color-accent);
  }

  /* Markdown content */
  .project-content {
    max-width: var(--reading-width);
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .project-content :global(h2) {
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    font-size: 1.8rem;
    line-height: 1.3;
  }

  .project-content :global(h3) {
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
    font-size: 1.3rem;
  }

  .project-content :global(p),
  .project-content :global(ul),
  .project-content :global(ol) {
    margin-bottom: var(--space-3);
  }

  .project-content :global(pre) {
    overflow-x: auto;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .project-footer {
    max-width: var(--reading-width);
    margin: var(--space-6) auto 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .project-footer .back-link {
    margin-bottom: 0;
  }

  @media (max-width: 700px) {
    .project-page {
      padding: var(--space-4) var(--space-3);
    }

    .project-header {
      margin-bottom: var(--space-4);
    }

    .project-cover {
      margin-bottom: var(--space-4);
    }

    .gallery-track {
      gap: 0.75rem;
      padding-inline: 5%;
      scroll-padding-inline: 5%;
    }

    .gallery-slide {
      flex-basis: 90%;
      height: 320px;
    }

    .gallery-arrow {
      width: 34px;
      height: 34px;
    }

    .project-content {
      font-size: 1rem;
      line-height: 1.75;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('.gallery-track');
  const previous = document.querySelector<HTMLButtonElement>('.gallery-prev');
  const next = document.querySelector<HTMLButtonElement>('.gallery-next');

  if (track && previous && next) {
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.gallery-slide'));

    let currentIndex = 0;

    // Scroll only the track horizontally. scrollIntoView() would also
    // scroll the page vertically to bring the slide into view.
    function centerSlide(slide: HTMLElement, behavior: ScrollBehavior) {
      const trackRect = track!.getBoundingClientRect();
      const slideRect = slide.getBoundingClientRect();

      track!.scrollTo({
        left:
          track!.scrollLeft +
          (slideRect.left - trackRect.left) -
          (trackRect.width - slideRect.width) / 2,
        behavior,
      });
    }

    requestAnimationFrame(() => {
      if (slides[0]) centerSlide(slides[0], 'instant');
    });

    function goToSlide(index: number) {
      currentIndex = Math.max(0, Math.min(index, slides.length - 1));

      centerSlide(
        slides[currentIndex],
        window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ? 'instant'
          : 'smooth',
      );
    }

    previous.addEventListener('click', () => goToSlide(currentIndex - 1));
    next.addEventListener('click', () => goToSlide(currentIndex + 1));
  }
</script>
