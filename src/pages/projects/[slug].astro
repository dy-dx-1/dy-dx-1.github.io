---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { getPublishedProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const { title, gallery, cover } = project.data;

// Main image is at most ~1100px wide on desktop and full width on phones
const mainWidths = [480, 800, 1100, 1600];
const mainSizes = '(max-width: 700px) 100vw, 1100px';
---

<Layout title={project.data.title} description={project.data.description}>
  <main class="project-page">
    <a class="back-link" href="/projects">← All projects</a>

    <header class="project-header">
      <p class="project-category">{project.data.category}</p>
      <h1>{project.data.title}</h1>
      <p class="project-description">{project.data.description}</p>

      <ul class="tag-list" aria-label="Technologies and topics">
        {project.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>

    {gallery.length > 0 ? (
      <section class="project-gallery" aria-label="Project images">
        <div class="gallery-main">
          {/* One slide per item; the script shows the selected one. Hidden
              lazy images aren't downloaded until they are shown. */}
          {gallery.map((item, index) =>
            'video' in item ? (
              <video
                class="gallery-slide"
                src={item.video}
                poster={item.poster?.src}
                aria-label={`${title} video`}
                muted
                loop
                playsinline
                autoplay={index === 0}
                preload={index === 0 ? 'auto' : 'none'}
                hidden={index !== 0}
              />
            ) : (
              <Image
                class="gallery-slide"
                src={item}
                widths={mainWidths}
                sizes={mainSizes}
                alt={`${title} image ${index + 1}`}
                loading={index === 0 ? 'eager' : 'lazy'}
                hidden={index !== 0}
              />
            ),
          )}

          {gallery.length > 1 && (
            <>
              <button
                class="gallery-arrow gallery-prev"
                type="button"
                aria-label="Previous image"
              >
                &#8592;
              </button>
              <button
                class="gallery-arrow gallery-next"
                type="button"
                aria-label="Next image"
              >
                &#8594;
              </button>
            </>
          )}
        </div>

        {gallery.length > 1 && (
          <ul class="gallery-thumbs" aria-label="Choose an image">
            {gallery.map((item, index) => (
              <li>
                <button
                  class="gallery-thumb"
                  type="button"
                  aria-label={`Show ${'video' in item ? 'video' : 'image'} ${index + 1}`}
                  aria-current={index === 0 ? 'true' : undefined}
                >
                  {'video' in item ? (
                    item.poster ? (
                      <Image src={item.poster} width={240} alt="" />
                    ) : (
                      // #t= makes the browser render a frame as the preview
                      <video src={`${item.video}#t=0.1`} muted playsinline preload="metadata" />
                    )
                  ) : (
                    // 2x the displayed 120px width for high-density screens
                    <Image src={item} width={240} alt="" />
                  )}
                  {'video' in item && <span class="gallery-thumb-play" aria-hidden="true">&#9654;</span>}
                </button>
              </li>
            ))}
          </ul>
        )}
      </section>
    ) : cover ? (
      <Image
        class="project-cover"
        src={cover}
        widths={mainWidths}
        sizes={mainSizes}
        alt={`Cover image for ${title}`}
        loading="eager"
      />
    ) : null}

    <article class="project-content">
      <Content />
    </article>

    <footer class="project-footer">
      <a class="back-link" href="/projects">← Back to all projects</a>
    </footer>
  </main>
</Layout>

<style>
  .project-page {
    width: 100%;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-5) var(--space-4);
  }

  .back-link {
    display: inline-block;
    margin-bottom: var(--space-5);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .project-header {
    max-width: var(--reading-width);
    margin: 0 auto var(--space-5);
  }

  .project-header .project-category {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
  }

  h1 {
    margin-bottom: var(--space-3);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .project-description {
    margin-bottom: var(--space-3);
    font-size: 1.2rem;
    line-height: 1.7;
  }

  .project-cover {
    display: block;
    width: 100%;
    max-height: 560px;
    object-fit: cover;
    object-position: center;
    border-radius: 4px;
    margin-bottom: var(--space-6);
  }

  /* Gallery */
  .project-gallery {
    --gallery-height: 520px;

    display: grid;
    grid-template-columns: minmax(0, 1fr) 120px;
    gap: var(--space-3);
    width: 100%;
    margin: 0 auto var(--space-6);
  }

  .gallery-main {
    position: relative;
    height: var(--gallery-height);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    background: var(--color-surface);
    overflow: hidden;
  }

  .gallery-slide {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .gallery-main [hidden] {
    display: none;
  }

  .gallery-thumbs {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-height: var(--gallery-height);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .gallery-thumb {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 4px;
    background: var(--color-surface);
    cursor: pointer;
    overflow: hidden;
    opacity: 0.6;
    transition: opacity 0.15s, border-color 0.15s;
  }

  .gallery-thumb img,
  .gallery-thumb video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-thumb-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 1.25rem;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
  }

  .gallery-thumb:hover {
    opacity: 1;
  }

  .gallery-thumb[aria-current='true'] {
    border-color: var(--color-accent);
    opacity: 1;
  }

  .gallery-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 42px;
    height: 42px;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-background);
    color: var(--color-text);
    cursor: pointer;
    font-size: 1.25rem;
  }

  .gallery-prev {
    left: 0.75rem;
  }

  .gallery-next {
    right: 0.75rem;
  }

  .gallery-arrow:hover {
    border-color: var(--color-accent);
  }

  /* Markdown content */
  .project-content {
    max-width: var(--reading-width);
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .project-content :global(h2) {
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    font-size: 1.8rem;
    line-height: 1.3;
  }

  .project-content :global(h3) {
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
    font-size: 1.3rem;
  }

  .project-content :global(p),
  .project-content :global(ul),
  .project-content :global(ol) {
    margin-bottom: var(--space-3);
  }

  .project-content :global(pre) {
    overflow-x: auto;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .project-footer {
    max-width: var(--reading-width);
    margin: var(--space-6) auto 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .project-footer .back-link {
    margin-bottom: 0;
  }

  @media (max-width: 700px) {
    .project-page {
      padding: var(--space-4) var(--space-3);
    }

    .project-header {
      margin-bottom: var(--space-4);
    }

    .project-cover {
      margin-bottom: var(--space-4);
    }

    /* Thumbnails move below the main image on narrow screens */
    .project-gallery {
      --gallery-height: 320px;

      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);
    }

    .gallery-thumbs {
      flex-direction: row;
      max-height: none;
      overflow-x: auto;
      overflow-y: hidden;
    }

    .gallery-thumbs li {
      flex: 0 0 88px;
    }

    .gallery-arrow {
      width: 34px;
      height: 34px;
    }

    .project-content {
      font-size: 1rem;
      line-height: 1.75;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-thumb {
      transition: none;
    }
  }
</style>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.gallery-main .gallery-slide'));
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery-thumb'));
  const previous = document.querySelector<HTMLButtonElement>('.gallery-prev');
  const next = document.querySelector<HTMLButtonElement>('.gallery-next');

  if (slides.length > 1) {
    let currentIndex = 0;

    function showImage(index: number) {
      // Wrap around at either end
      currentIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        slide.hidden = i !== currentIndex;

        if (slide instanceof HTMLVideoElement) {
          if (i === currentIndex) slide.play().catch(() => {});
          else slide.pause();
        }
      });

      const thumb = thumbs[currentIndex];
      thumbs.forEach((t) => t.removeAttribute('aria-current'));
      thumb.setAttribute('aria-current', 'true');
      // Scroll only the thumbnail list. scrollIntoView() could also
      // scroll the page to bring the thumbnail into view.
      const list = thumb.closest('ul')!;
      const listRect = list.getBoundingClientRect();
      const thumbRect = thumb.getBoundingClientRect();
      list.scrollBy({
        top: thumbRect.top - listRect.top - (listRect.height - thumbRect.height) / 2,
        left: thumbRect.left - listRect.left - (listRect.width - thumbRect.width) / 2,
      });
    }

    thumbs.forEach((thumb, index) => {
      thumb.addEventListener('click', () => showImage(index));
    });

    previous?.addEventListener('click', () => showImage(currentIndex - 1));
    next?.addEventListener('click', () => showImage(currentIndex + 1));

    // Left/right arrow keys switch images anywhere on the page, unless the
    // user is typing or using a shortcut.
    document.addEventListener('keydown', (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;

      const target = event.target as HTMLElement;
      if (target.closest('input, textarea, select, [contenteditable]')) return;

      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        showImage(currentIndex - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        showImage(currentIndex + 1);
      }
    });
  }
</script>
