---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects
    .filter((project) => import.meta.env.DEV || !project.data.draft)
    .map((project) => ({
      params: { slug: project.id },
      props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={`${project.data.title} | Nicolas`}>
  <main class="project-page">
    <a class="back-link" href="/projects">← All projects</a>

    <header class="project-header">
      <p class="project-category">{project.data.category}</p>
      <h1>{project.data.title}</h1>
      <p class="project-description">{project.data.description}</p>

      <ul class="project-tags" aria-label="Technologies and topics">
        {project.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>

    {project.data.gallery.length > 0 ? (
      <section class="project-gallery" aria-label="Project images">
        <button
          class="gallery-arrow gallery-prev"
          type="button"
          aria-label="Previous image"
        >
          &#8592;
        </button>

        <div class="gallery-track">
          {project.data.gallery.map((image, index) => (
            <div class="gallery-slide">
              <img
                src={image}
                alt={`${project.data.title} image ${index + 1}`}
                loading="lazy"
              />
            </div>
          ))}
        </div>

        <button
          class="gallery-arrow gallery-next"
          type="button"
          aria-label="Next image"
        >
          &#8594;
        </button>
      </section>
    ) : project.data.cover ? (
      <img
        class="project-cover"
        src={project.data.cover}
        alt={`Cover image for ${project.data.title}`}
      />
    ) : null}

    <article class="project-content">
      <Content />
    </article>

    <footer class="project-footer">
      <a class="back-link" href="/projects">← Back to all projects</a>
    </footer>
  </main>
</Layout>

<style>
  .project-page {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-5) var(--space-4);
  }

  .back-link {
    display: inline-block;
    color: var(--color-muted, #777);
    text-decoration: none;
    margin-bottom: var(--space-5);
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .project-header {
    max-width: 850px;
    margin: 0 auto var(--space-5);
  }

  .project-category {
    margin-bottom: var(--space-2);
    color: var(--color-accent);
    font-size: 0.9rem;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-3);
  }

  .project-description {
    font-size: 1.2rem;
    line-height: 1.7;
    margin-bottom: var(--space-3);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
  }

  .project-tags li {
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 0.4rem 0.65rem;
    font-size: 0.85rem;
  }

  .project-cover {
    display: block;
    width: 100%;
    max-height: 560px;
    object-fit: cover;
    object-position: center;
    border-radius: 4px;
    margin-bottom: var(--space-6);
  }

  .project-content {
    max-width: var(--reading-width);
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .project-content :global(h2) {
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    font-size: 1.8rem;
    line-height: 1.3;
  }

  .project-content :global(h3) {
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
    font-size: 1.3rem;
  }

  .project-content :global(p),
  .project-content :global(ul),
  .project-content :global(ol) {
    margin-bottom: var(--space-3);
  }

  .project-content :global(img) {
    max-width: 100%;
    height: auto;
  }

  .project-content :global(pre) {
    overflow-x: auto;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }


.project-gallery {
  position: relative;
  width: 100%;
  margin-bottom: var(--space-6);
}

.gallery-track {
  display: flex;
  gap: 1rem;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  scrollbar-width: none;
}

.gallery-track::-webkit-scrollbar {
  display: none;
}

.gallery-slide {
  flex: 0 0 85%;
  scroll-snap-align: center;
  min-width: 0;
}

.gallery-slide img {
  display: block;
  width: 100%;
  height: 480px;
  object-fit: contain;
  border-radius: 4px;
}

.gallery-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  width: 42px;
  height: 42px;
  border: 1px solid var(--color-border);
  border-radius: 50%;
  background: var(--color-bg);
  color: var(--color-text);
  cursor: pointer;
  font-size: 1.25rem;
}

.gallery-prev {
  left: 1rem;
}

.gallery-next {
  right: 1rem;
}

  .gallery-arrow:hover {
    border-color: var(--color-accent);
  }

  @media (max-width: 700px) {
    .gallery-slide {
      flex-basis: 92%;
    }

    .gallery-slide img {
      height: 280px;
    }

    .gallery-arrow {
      width: 34px;
      height: 34px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-track {
      scroll-behavior: auto;
    }
  }


  .project-footer {
    margin-top: var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 700px) {
    .project-page {
      padding: var(--space-4) var(--space-3);
    }
    .project-header {
      margin-bottom: var(--space-4);
    }

    .project-cover {
      margin-bottom: var(--space-4);
    }

    .project-content {
      font-size: 1rem;
      line-height: 1.75;
    }
    .project-gallery {
      grid-template-columns: 1fr;
      margin-bottom: var(--space-4);
    }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('.gallery-track');
  const previous = document.querySelector<HTMLButtonElement>('.gallery-prev');
  const next = document.querySelector<HTMLButtonElement>('.gallery-next');

  if (track && previous && next) {
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.gallery-slide'));

    let currentIndex = 0;

    function goToSlide(index: number) {
      currentIndex = Math.max(0, Math.min(index, slides.length - 1));

      slides[currentIndex].scrollIntoView({
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ? 'instant'
          : 'smooth',
        block: 'nearest',
        inline: 'center',
      });
    }

    previous.addEventListener('click', () => goToSlide(currentIndex - 1));
    next.addEventListener('click', () => goToSlide(currentIndex + 1));
  }
</script>
