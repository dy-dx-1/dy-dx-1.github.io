---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    number: '01',
    title: 'Collaborative Localization',
    category: 'RESEARCH · EMBEDDED SYSTEMS',
    description:
      'Developing a distributed localization system combining UWB ranging, inertial measurements, and factor-graph optimization.',
    tags: ['C++', 'IMU', 'UWB', 'GTSAM'],
    image: null,
  },
  {
    number: '02',
    title: 'TDOA Localization for Bitcraze',
    category: 'RESEARCH ASSISTANT · LOCALIZATION',
    description:
      'Developing a TDOA-based localization system for Bitcraze anchors and tags, from ranging measurements to position estimates.',
    tags: ['Localization', 'Embedded Systems', 'TDOA'],
    image: null,
  },
  {
    number: '03',
    title: 'Turbofan Vibration Analysis',
    category: 'RESEARCH SCHOLARSHIP · SOFTWARE',
    description:
      'Developed a graphical interface to support vibration analysis of turbofan engines.',
    tags: ['Python', 'Data Visualization', 'Vibration'],
    image: null,
  },
  {
    number: '04',
    title: 'Motorized Standing Desk',
    category: 'PERSONAL PROJECT · MECHATRONICS',
    description:
      'Exploring the conversion of a manually adjustable standing desk into a motorized system.',
    tags: ['Mechanical Design', 'Electronics', 'Control'],
    image: null,
  },
  {
    number: '05',
    title: 'Custom Rover Wheels',
    category: 'POLYORBITE · MECHANICAL DESIGN',
    description:
      'Designing custom 3D-printed wheels for a rover, balancing geometry, manufacturability, and terrain performance.',
    tags: ['CAD', '3D Printing', 'Robotics'],
    image: null,
  },
  {
    number: '06',
    title: 'PowerUp Plane Reverse Engineering',
    category: 'PERSONAL PROJECT · SYSTEMS',
    description:
      'Investigating a small PowerUp aircraft and developing a custom controller to understand and replace parts of its control system.',
    tags: ['Reverse Engineering', 'Electronics', 'Control'],
    image: null,
  },
  {
    number: '07',
    title: 'Turbojet Modal Analysis',
    category: 'CAPSTONE · MECHANICAL ENGINEERING',
    description:
      'Collaborative modal analysis of a custom turbojet, investigating its dynamic response and vibration characteristics.',
    tags: ['Modal Analysis', 'Dynamics', 'Team Design'],
    image: null,
  },
  {
    number: '08',
    title: 'Telescope Cooling System',
    category: 'PERSONAL PROJECT · THERMAL DESIGN',
    description:
      'Modifying a Dobsonian telescope with a PC fan to improve thermal management and observing performance.',
    tags: ['Thermal Management', 'Mechanical Design'],
    image: null,
  },
  {
    number: '09',
    title: 'PolyOrbite',
    category: 'ROBOTICS · LEADERSHIP',
    description:
      'A multidisciplinary rover team experience spanning technical development, systems integration, team leadership, and event organization.',
    tags: ['Robotics', 'Systems Engineering', 'Leadership'],
    image: null,
  },
];

---

<Layout>
  <div class="site-shell">
    <header class="site-header container">
      <a class="wordmark" href="/" aria-label="Home">
        Nicolas<span class="wordmark-period">.</span>
      </a>

      <nav aria-label="Main navigation">
        <a href="/projects" aria-current="page">Projects</a>
        <a href="/about">About</a>
      </nav>
    </header>

    <main class="container">
      <section class="page-intro">
        <p class="eyebrow">Selected work / Research / Personal projects</p>
        <h1>Projects<span class="wordmark-period">.</span></h1>
        <p class="page-description">
          A collection of engineering projects, research, and experiments
          across hardware, software, and multidisciplinary systems.
        </p>
      </section>

      <section class="projects-grid" aria-label="Project portfolio">
        {projects.map((project) => (
          <article class="project-card">
            <div class="project-image">
              {project.image ? (
                <img src={project.image} alt="" loading="lazy" />
              ) : (
                <div class="image-placeholder" aria-hidden="true">
                  <span>{project.number}</span>
                  <span class="placeholder-label">IMAGE / TO BE ADDED</span>
                </div>
              )}
            </div>

            <div class="project-info">
              <p class="project-category">{project.category}</p>
              <h2>{project.title}</h2>
              <p class="project-description">{project.description}</p>

              <ul class="project-tags" aria-label="Technologies and topics">
                {project.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </section>
    </main>

    <footer class="site-footer container">
      <span>Engineering portfolio</span>
      <a href="/">Back to home ↑</a>
      <span>© {new Date().getFullYear()} Nicolas</span>
    </footer>
  </div>
</Layout>

<style>
  .site-shell {
    min-height: 100vh;
  }

  .site-header {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .wordmark {
    color: var(--color-text);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .wordmark-period {
    color: var(--color-accent);
  }

  nav {
    display: flex;
    gap: var(--space-3);
  }

  nav a,
  .site-footer a {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  nav a:hover,
  .site-footer a:hover {
    color: var(--color-accent);
  }

  nav a[aria-current='page'] {
    color: var(--color-text);
  }

  .page-intro {
    max-width: 700px;
    padding-top: clamp(4rem, 10vw, 7rem);
    padding-bottom: var(--space-5);
  }

  .page-intro .eyebrow {
    margin-bottom: var(--space-3);
  }

  h1 {
    margin-bottom: var(--space-3);
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 1;
  }

  .page-description {
    max-width: 570px;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

    .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-6);
    row-gap: var(--space-5);
    padding-bottom: var(--space-6);
    }

  .project-card {
    min-width: 0;
  }

  .project-image {
    width: 100%;
    aspect-ratio: 3 / 2;
    margin-bottom: var(--space-3);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    color: var(--color-text-muted);
    background-image: linear-gradient(
      135deg,
      transparent 49.8%,
      var(--color-border) 50%,
      transparent 50.2%
    );
  }

  .image-placeholder > span:first-child {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    opacity: 0.55;
  }

  .placeholder-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
  }

  .project-category {
    margin-bottom: 0.6rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.035em;
  }

    .project-info h2 {
    margin-bottom: 0.85rem;
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    }

    .project-description {
    max-width: 600px;
    margin-bottom: var(--space-3);
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.75;
    }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .project-tags li {
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  @media (max-width: 700px) {
    .projects-grid {
      grid-template-columns: 1fr;
      row-gap: var(--space-5);
    }

    .project-image {
      aspect-ratio: 16 / 9;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-image img {
      transition: transform 250ms ease;
    }

    .project-card:hover .project-image img {
      transform: scale(1.02);
    }
  }
</style>