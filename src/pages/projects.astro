---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getPublishedProjects } from '../lib/projects';

const projects = await getPublishedProjects();
---

<Layout
  title="Projects"
  description="Engineering projects, research, and experiments across hardware, software, and multidisciplinary systems."
>
  <main class="container">
    <section class="page-intro">
      <h1>Projects</h1>
      <p class="page-description">
        A collection of multidisciplinary engineering projects I've worked on over the years.
      </p>
    </section>

    <section class="projects-grid" aria-label="Project portfolio">
      {projects.map((project) => {
        // Fall back to the first gallery image when no cover is set.
        const image =
          project.data.cover ??
          project.data.gallery.find((item) => 'image' in item)?.image;

        return (
          <a class="project-card" href={`/projects/${project.id}`}>
            <div class="project-image">
              {image ? (
                <Image
                  src={image}
                  widths={[400, 800, 1200]}
                  sizes="(max-width: 700px) 100vw, 600px"
                  alt=""
                />
              ) : (
                <div class="image-placeholder" aria-hidden="true">
                  <span>{String(project.data.order ?? '').padStart(2, '0')}</span>
                  <span class="placeholder-label">IMAGE / TO BE ADDED</span>
                </div>
              )}
            </div>

            <div class="project-info">
              <div class="project-meta">
                <p class="project-category">{project.data.category}</p>
                {project.data.year && <p class="project-year">{project.data.year}</p>}
              </div>
              <h2>{project.data.title}</h2>
              <p class="project-description">{project.data.description}</p>

              <ul class="tag-list" aria-label="Technologies and topics">
                {project.data.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </div>
          </a>
        );
      })}
    </section>
  </main>
</Layout>

<style>
  .page-intro {
    max-width: 700px;
    padding-top: clamp(4rem, 10vw, 7rem);
    padding-bottom: var(--space-5);
  }

  .page-intro .eyebrow {
    margin-bottom: var(--space-3);
  }

  h1 {
    margin-bottom: var(--space-3);
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 1;
  }

  .page-description {
    max-width: 570px;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-6);
    row-gap: var(--space-5);
    padding-bottom: var(--space-6);
  }

  .project-card {
    display: block;
    color: inherit;
    text-decoration: none;
    min-width: 0;
  }

  .project-card:hover h2 {
    color: var(--color-accent);
  }

  .project-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
  }

  .project-image {
    width: 100%;
    aspect-ratio: 3 / 2;
    margin-bottom: var(--space-3);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .project-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Reduced-motion users are handled globally in global.css. */
  .project-image img,
  .image-placeholder {
    transition: transform 250ms ease;
  }

  .project-card:hover .project-image img,
  .project-card:hover .image-placeholder {
    transform: scale(1.02);
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    color: var(--color-text-muted);
    background-image: linear-gradient(
      135deg,
      transparent 49.8%,
      var(--color-border) 50%,
      transparent 50.2%
    );
  }

  .image-placeholder > span:first-child {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    opacity: 0.55;
  }

  .placeholder-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
  }

  .project-info h2 {
    margin-bottom: 0.85rem;
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .project-description {
    max-width: 600px;
    margin-bottom: var(--space-3);
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.75;
  }

  @media (max-width: 700px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .project-image {
      aspect-ratio: 16 / 9;
    }
  }
</style>
